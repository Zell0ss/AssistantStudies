[Unit]
Description=Sebastian 2.0 - Personal Assistant Telegram Bot
After=network.target mariadb.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/data/AssistantStudies/sebastian2
ExecStart=/data/AssistantStudies/sebastian2/.venv/bin/python3 /data/AssistantStudies/sebastian2/sebastian_bot.py
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sebastian2

# Environment
Environment="PYTHONUNBUFFERED=1"
# D19/D20: producción fija aquí su BD y su colección; el config.yaml es de desarrollo.
# Environment= (nunca EnvironmentFile=, que lo pisaría).
Environment="SEBASTIAN_DB_NAME=sebastian_db"
Environment="SEBASTIAN_MEMORY_COLLECTION=sebastian_memory"
Environment="PATH=/data/AssistantStudies/sebastian2/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin"

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
