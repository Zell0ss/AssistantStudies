[Unit]
Description=El cuaderno - un despertar de Claude en seb01 (Sprint 4)
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/data/AssistantStudies/sebastian2
ExecStart=/data/AssistantStudies/sebastian2/.venv/bin/python3 -m scripts.cuaderno.despertar
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cuaderno

# Environment
Environment="PYTHONUNBUFFERED=1"
# D19/D20: producción fija aquí su BD y su colección; el config.yaml es de desarrollo.
Environment="SEBASTIAN_DB_NAME=sebastian_db"
Environment="SEBASTIAN_MEMORY_COLLECTION=sebastian_memory"

# Security
NoNewPrivileges=true
